      <column caption='Decision Status Group' datatype='string' name='[Calculation_0160564940824590]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] = &apos;SUPPORTED&apos;&#13;&#10;OR [Status] = &apos;STRONG / VERIFIED&apos;&#13;&#10;OR [Status] = &apos;STRONG / USAGE SIGNAL&apos;&#13;&#10;THEN &apos;Established / Strong&apos;&#13;&#10;&#13;&#10;ELSEIF [Status] = &apos;STRONG CANDIDATE&apos;&#13;&#10;OR [Status] = &apos;PARTIALLY PROVEN&apos;&#13;&#10;OR [Status] = &apos;PROVEN AT POC&apos;&#13;&#10;THEN &apos;Developing / Partial&apos;&#13;&#10;&#13;&#10;ELSEIF [Status] = &apos;UNPROVEN&apos;&#13;&#10;THEN &apos;Unproven&apos;&#13;&#10;&#13;&#10;ELSEIF [Status] = &apos;MATERIAL&apos;&#13;&#10;THEN &apos;Material Risk&apos;&#13;&#10;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='Decision Order' datatype='integer' name='[Calculation_0160564942860303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Decision_Dimension]&#13;&#10;WHEN &apos;Market Need&apos; THEN 1&#13;&#10;WHEN &apos;Legacy FX Position&apos; THEN 2&#13;&#10;WHEN &apos;Distribution Asset&apos; THEN 3&#13;&#10;WHEN &apos;Strategic Stack&apos; THEN 4&#13;&#10;WHEN &apos;Interoperability&apos; THEN 5&#13;&#10;WHEN &apos;Liquidity / FX Economics&apos; THEN 6&#13;&#10;WHEN &apos;Compliance / Governance&apos; THEN 7&#13;&#10;WHEN &apos;Execution&apos; THEN 8&#13;&#10;WHEN &apos;Commercialization&apos; THEN 9&#13;&#10;WHEN &apos;Risk / Regulation&apos; THEN 10&#13;&#10;END' />
      </column>
      <column caption='Counterevidence or Alternative' datatype='string' name='[Counterevidence_or_Alternative]' role='dimension' type='nominal' />
      <column caption='Current Conclusion' datatype='string' name='[Current_Conclusion]' role='dimension' type='nominal' />
