    <worksheet name='Strategic Conversion Ladder'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='하나2.0 R' fontsize='14'>전략 전환 단계</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DS_REGISTRY' name='federated.0c8tl4o1bnm2hv11clogo1frst0g' />
          </datasources>
          <datasource-dependencies datasource='federated.0c8tl4o1bnm2hv11clogo1frst0g'>
            <column caption='Decision Readiness' datatype='string' name='[Calculation_0160564888436737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos; THEN &apos;Normalized&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;Normalized / Precondition&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;CAUTION&apos;&#13;&#10;THEN &apos;Conditional&apos;&#13;&#10;&#13;&#10;ELSE &apos;Blocked&apos;&#13;&#10;END' />
            </column>
            <column caption='Decision Ladder Order' datatype='integer' name='[Calculation_0160564898127876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C08&apos; THEN 1&#13;&#10;WHEN &apos;C09&apos; THEN 2&#13;&#10;WHEN &apos;C10&apos; THEN 3&#13;&#10;WHEN &apos;C12&apos; THEN 4&#13;&#10;WHEN &apos;C14&apos; THEN 5&#13;&#10;WHEN &apos;C15&apos; THEN 6&#13;&#10;WHEN &apos;C16&apos; THEN 7&#13;&#10;WHEN &apos;C17&apos; THEN 8&#13;&#10;WHEN &apos;C18-C&apos; THEN 9&#13;&#10;END' />
            </column>
            <column caption='Decision Ladder Stage' datatype='string' name='[Calculation_0160564898185221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C08&apos; THEN &apos;PoC&apos;&#13;&#10;WHEN &apos;C09&apos; THEN &apos;Intent&apos;&#13;&#10;WHEN &apos;C10&apos; THEN &apos;Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;Speed Outcome&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;Cost Outcome&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;Commercial Economics&apos;&#13;&#10;WHEN &apos;C18-C&apos; THEN &apos;Economic Advantage&apos;&#13;&#10;END' />
            </column>
            <column caption='Decision Ladder Position' datatype='integer' name='[Calculation_0160564898516998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Claim Unit' datatype='string' name='[Claim_Unit]' role='dimension' type='nominal' />
            <column caption='Tableau Status' datatype='string' name='[Tableau_Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0160564898127876]' derivation='Min' name='[min:Calculation_0160564898127876:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0160564888436737]' derivation='None' name='[none:Calculation_0160564888436737:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564898185221]' derivation='None' name='[none:Calculation_0160564898185221:nk]' pivot='key' type='nominal' />
            <column-instance column='[Claim_Unit]' derivation='None' name='[none:Claim_Unit:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564898516998]' derivation='Sum' name='[sum:Calculation_0160564898516998:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
