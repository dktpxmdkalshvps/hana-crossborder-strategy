      <aliases enabled='yes' />
      <column caption='Assertion Class' datatype='string' name='[Assertion_Class]' role='dimension' type='nominal' />
      <column caption='Assertion Qualifier' datatype='string' name='[Assertion_Qualifier]' role='dimension' type='nominal' />
      <column caption='Branch Order' datatype='integer' name='[Branch_Order]' role='measure' type='quantitative' />
      <column caption='Branch Sort' datatype='integer' name='[Calculation_0160564888178688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Branch]&#13;&#10;WHEN &apos;Market&apos; THEN 1&#13;&#10;WHEN &apos;Strategy&apos; THEN 2&#13;&#10;WHEN &apos;Adoption&apos; THEN 3&#13;&#10;WHEN &apos;Performance&apos; THEN 4&#13;&#10;WHEN &apos;Commercial&apos; THEN 5&#13;&#10;WHEN &apos;Decision&apos; THEN 6&#13;&#10;END' />
      </column>
      <column caption='Decision Readiness' datatype='string' name='[Calculation_0160564888436737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos; THEN &apos;Normalized&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;Normalized / Precondition&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;CAUTION&apos;&#13;&#10;THEN &apos;Conditional&apos;&#13;&#10;&#13;&#10;ELSE &apos;Blocked&apos;&#13;&#10;END' />
      </column>
      <column caption='Blocked Flag' datatype='integer' name='[Calculation_0160564888576002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Tableau_Status] = &apos;BLOCKED&apos; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Precondition Flag' datatype='integer' name='[Calculation_0160564888662019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Judgment_Precondition] = &apos;None&apos;&#13;&#10;OR ISNULL([Judgment_Precondition])&#13;&#10;THEN 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Decision Ladder Order' datatype='integer' name='[Calculation_0160564898127876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C08&apos; THEN 1&#13;&#10;WHEN &apos;C09&apos; THEN 2&#13;&#10;WHEN &apos;C10&apos; THEN 3&#13;&#10;WHEN &apos;C12&apos; THEN 4&#13;&#10;WHEN &apos;C14&apos; THEN 5&#13;&#10;WHEN &apos;C15&apos; THEN 6&#13;&#10;WHEN &apos;C16&apos; THEN 7&#13;&#10;WHEN &apos;C17&apos; THEN 8&#13;&#10;WHEN &apos;C18-C&apos; THEN 9&#13;&#10;END' />
      </column>
      <column caption='Decision Ladder Stage' datatype='string' name='[Calculation_0160564898185221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C08&apos; THEN &apos;PoC&apos;&#13;&#10;WHEN &apos;C09&apos; THEN &apos;Intent&apos;&#13;&#10;WHEN &apos;C10&apos; THEN &apos;Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;Speed Outcome&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;Cost Outcome&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;Commercial Economics&apos;&#13;&#10;WHEN &apos;C18-C&apos; THEN &apos;Economic Advantage&apos;&#13;&#10;END' />
      </column>
      <column caption='Decision Ladder Position' datatype='integer' name='[Calculation_0160564898516998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='GIWA Maturity Stage' datatype='string' name='[Calculation_0160564931989513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C08&apos; THEN &apos;1. PoC&apos;&#13;&#10;WHEN &apos;C09&apos; THEN &apos;2. Follow-up Intent&apos;&#13;&#10;WHEN &apos;C10&apos; THEN &apos;3. Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;4. Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;5A. Speed Performance&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;5B. Cost Performance&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;6. Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;7. Commercial Economics&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='GIWA Maturity Order' datatype='integer' name='[Calculation_0160564932079626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C08&apos; THEN 1&#13;&#10;WHEN &apos;C09&apos; THEN 2&#13;&#10;WHEN &apos;C10&apos; THEN 3&#13;&#10;WHEN &apos;C12&apos; THEN 4&#13;&#10;WHEN &apos;C14&apos; THEN 5&#13;&#10;WHEN &apos;C15&apos; THEN 6&#13;&#10;WHEN &apos;C16&apos; THEN 7&#13;&#10;WHEN &apos;C17&apos; THEN 8&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Stack Position' datatype='integer' name='[Calculation_0160564932431883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='GIWA Blocker Type' datatype='string' name='[Calculation_0160564936441868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos;&#13;&#10;OR [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;No Closure Blocker&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;semantic&apos;)&#13;&#10;THEN &apos;Semantic / Scope&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;dependency&apos;)&#13;&#10;OR CONTAINS(LOWER([Dependency_or_Blocker]), &apos;qa-&apos;)&#13;&#10;THEN &apos;Dependency&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;framework&apos;)&#13;&#10;OR CONTAINS(LOWER([Dependency_or_Blocker]), &apos;fg-&apos;)&#13;&#10;THEN &apos;Framework&apos;&#13;&#10;&#13;&#10;ELSE &apos;Other / Mixed&apos;&#13;&#10;END' />
      </column>
      <column caption='GIWA Blocker Display' datatype='string' name='[Calculation_0160564937359373]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos;&#13;&#10;OR [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;No Closure Blocker&apos;&#13;&#10;ELSE [Dependency_or_Blocker]&#13;&#10;END' />
      </column>
      <column caption='Decision Trigger Stage' datatype='string' name='[Calculation_0160564943519760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C10&apos; THEN &apos;Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;Speed Performance&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;Cost Performance&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;Commercial Economics&apos;&#13;&#10;END' />
      </column>
      <column caption='Trigger Order' datatype='integer' name='[Calculation_0160564943564817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;WHEN &apos;C10&apos; THEN 1&#13;&#10;WHEN &apos;C12&apos; THEN 2&#13;&#10;WHEN &apos;C14&apos; THEN 3&#13;&#10;WHEN &apos;C15&apos; THEN 4&#13;&#10;WHEN &apos;C16&apos; THEN 5&#13;&#10;WHEN &apos;C17&apos; THEN 6&#13;&#10;END' />
      </column>
      <column caption='Decision Trigger' datatype='string' name='[Calculation_0160564943609874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C10&apos; THEN&#13;&#10;&apos;Official production-architecture adoption&apos;&#13;&#10;&#13;&#10;WHEN &apos;C12&apos; THEN&#13;&#10;&apos;Production-stack integration evidence&apos;&#13;&#10;&#13;&#10;WHEN &apos;C14&apos; THEN&#13;&#10;&apos;Measured production E2E speed vs baseline&apos;&#13;&#10;&#13;&#10;WHEN &apos;C15&apos; THEN&#13;&#10;&apos;Measured all-in cost vs baseline&apos;&#13;&#10;&#13;&#10;WHEN &apos;C16&apos; THEN&#13;&#10;&apos;Real-value live commercial transactions&apos;&#13;&#10;&#13;&#10;WHEN &apos;C17&apos; THEN&#13;&#10;&apos;Repeatable revenue / cost / economics&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Decision Trigger Display' datatype='string' name='[Calculation_0160564947406867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0160564943519760]&#13;&#10;+ CHAR(10)&#13;&#10;+ [Calculation_0160564943609874]' />
      </column>
