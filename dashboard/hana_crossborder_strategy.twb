    <worksheet name='EX05_BRANCH_STATUS'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='하나2.0 R' fontsize='14'>의사결정 영역별 레지스트리 준비도</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DS_REGISTRY' name='federated.0c8tl4o1bnm2hv11clogo1frst0g' />
          </datasources>
          <datasource-dependencies datasource='federated.0c8tl4o1bnm2hv11clogo1frst0g'>
            <column datatype='string' name='[Branch]' role='dimension' type='nominal' />
            <column caption='Branch Sort' datatype='integer' name='[Calculation_0160564888178688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Branch]&#13;&#10;WHEN &apos;Market&apos; THEN 1&#13;&#10;WHEN &apos;Strategy&apos; THEN 2&#13;&#10;WHEN &apos;Adoption&apos; THEN 3&#13;&#10;WHEN &apos;Performance&apos; THEN 4&#13;&#10;WHEN &apos;Commercial&apos; THEN 5&#13;&#10;WHEN &apos;Decision&apos; THEN 6&#13;&#10;END' />
            </column>
            <column caption='Decision Readiness' datatype='string' name='[Calculation_0160564888436737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos; THEN &apos;Normalized&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;Normalized / Precondition&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;CAUTION&apos;&#13;&#10;THEN &apos;Conditional&apos;&#13;&#10;&#13;&#10;ELSE &apos;Blocked&apos;&#13;&#10;END' />
            </column>
            <column caption='Claim Unit' datatype='string' name='[Claim_Unit]' role='dimension' type='nominal' />
            <column caption='Tableau Status' datatype='string' name='[Tableau_Status]' role='dimension' type='nominal' />
            <column-instance column='[Claim_Unit]' derivation='CountD' name='[ctd:Claim_Unit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0160564888178688]' derivation='Min' name='[min:Calculation_0160564888178688:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Branch]' derivation='None' name='[none:Branch:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564888436737]' derivation='None' name='[none:Calculation_0160564888436737:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0c8tl4o1bnm2hv11clogo1frst0g].[none:Branch:nk]' direction='ASC' using='[federated.0c8tl4o1bnm2hv11clogo1frst0g].[min:Calculation_0160564888178688:qk]' />
