    <worksheet name='HS02_GIWA_BLOCKER_MAP'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='하나2.0 R'>GIWA가 다음 단계로 넘어가기 위해 해결해야 할 과제</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='하나2.0 R' fontsize='12'>다음 단계 진입을 막는 요인과 판단에 필요한 선행조건을 구분해 관리한다.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DS_REGISTRY' name='federated.0c8tl4o1bnm2hv11clogo1frst0g' />
          </datasources>
          <datasource-dependencies datasource='federated.0c8tl4o1bnm2hv11clogo1frst0g'>
            <column caption='GIWA Maturity Stage' datatype='string' name='[Calculation_0160564931989513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C08&apos; THEN &apos;1. PoC&apos;&#13;&#10;WHEN &apos;C09&apos; THEN &apos;2. Follow-up Intent&apos;&#13;&#10;WHEN &apos;C10&apos; THEN &apos;3. Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;4. Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;5A. Speed Performance&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;5B. Cost Performance&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;6. Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;7. Commercial Economics&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GIWA Blocker Type' datatype='string' name='[Calculation_0160564936441868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos;&#13;&#10;OR [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;No Closure Blocker&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;semantic&apos;)&#13;&#10;THEN &apos;Semantic / Scope&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;dependency&apos;)&#13;&#10;OR CONTAINS(LOWER([Dependency_or_Blocker]), &apos;qa-&apos;)&#13;&#10;THEN &apos;Dependency&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Dependency_or_Blocker]), &apos;framework&apos;)&#13;&#10;OR CONTAINS(LOWER([Dependency_or_Blocker]), &apos;fg-&apos;)&#13;&#10;THEN &apos;Framework&apos;&#13;&#10;&#13;&#10;ELSE &apos;Other / Mixed&apos;&#13;&#10;END' />
            </column>
            <column caption='Claim Unit' datatype='string' name='[Claim_Unit]' role='dimension' type='nominal' />
            <column caption='Dependency or Blocker' datatype='string' name='[Dependency_or_Blocker]' role='dimension' type='nominal' />
            <column caption='Judgment Precondition' datatype='string' name='[Judgment_Precondition]' role='dimension' type='nominal' />
            <column caption='Tableau Status' datatype='string' name='[Tableau_Status]' role='dimension' type='nominal' />
            <column-instance column='[Judgment_Precondition]' derivation='Attribute' name='[attr:Judgment_Precondition:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564931989513]' derivation='None' name='[none:Calculation_0160564931989513:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564936441868]' derivation='None' name='[none:Calculation_0160564936441868:nk]' pivot='key' type='nominal' />
            <column-instance column='[Claim_Unit]' derivation='None' name='[none:Claim_Unit:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0c8tl4o1bnm2hv11clogo1frst0g].[none:Claim_Unit:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Claim_Unit:nk]' member='&quot;C08&quot;' />
              <groupfilter function='member' level='[none:Claim_Unit:nk]' member='&quot;C09&quot;' />
