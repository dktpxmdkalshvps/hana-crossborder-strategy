    <worksheet name='HS01_GIWA_MATURITY_STACK'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='하나2.0 R'>GIWA 성숙도 단계: PoC에서 상업적 경제성까지</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='하나2.0 R' fontsize='12'>각 단계는 별도의 근거를 필요로 하며, PoC 완료만으로 후속 단계의 준비도를 추론할 수 없다.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DS_REGISTRY' name='federated.0c8tl4o1bnm2hv11clogo1frst0g' />
          </datasources>
          <datasource-dependencies datasource='federated.0c8tl4o1bnm2hv11clogo1frst0g'>
            <column caption='Decision Readiness' datatype='string' name='[Calculation_0160564888436737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tableau_Status] = &apos;READY&apos; THEN &apos;Normalized&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;READY_WITH_PRECONDITION&apos;&#13;&#10;THEN &apos;Normalized / Precondition&apos;&#13;&#10;&#13;&#10;ELSEIF [Tableau_Status] = &apos;CAUTION&apos;&#13;&#10;THEN &apos;Conditional&apos;&#13;&#10;&#13;&#10;ELSE &apos;Blocked&apos;&#13;&#10;END' />
            </column>
            <column caption='GIWA Maturity Stage' datatype='string' name='[Calculation_0160564931989513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C08&apos; THEN &apos;1. PoC&apos;&#13;&#10;WHEN &apos;C09&apos; THEN &apos;2. Follow-up Intent&apos;&#13;&#10;WHEN &apos;C10&apos; THEN &apos;3. Formal Adoption&apos;&#13;&#10;WHEN &apos;C12&apos; THEN &apos;4. Production Integration&apos;&#13;&#10;WHEN &apos;C14&apos; THEN &apos;5A. Speed Performance&apos;&#13;&#10;WHEN &apos;C15&apos; THEN &apos;5B. Cost Performance&apos;&#13;&#10;WHEN &apos;C16&apos; THEN &apos;6. Live Commercialization&apos;&#13;&#10;WHEN &apos;C17&apos; THEN &apos;7. Commercial Economics&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GIWA Maturity Order' datatype='integer' name='[Calculation_0160564932079626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Claim_Unit]&#13;&#10;&#13;&#10;WHEN &apos;C08&apos; THEN 1&#13;&#10;WHEN &apos;C09&apos; THEN 2&#13;&#10;WHEN &apos;C10&apos; THEN 3&#13;&#10;WHEN &apos;C12&apos; THEN 4&#13;&#10;WHEN &apos;C14&apos; THEN 5&#13;&#10;WHEN &apos;C15&apos; THEN 6&#13;&#10;WHEN &apos;C16&apos; THEN 7&#13;&#10;WHEN &apos;C17&apos; THEN 8&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Stack Position' datatype='integer' name='[Calculation_0160564932431883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Claim Unit' datatype='string' name='[Claim_Unit]' role='dimension' type='nominal' />
            <column caption='Dependency or Blocker' datatype='string' name='[Dependency_or_Blocker]' role='dimension' type='nominal' />
            <column caption='Evidence Coverage Status' datatype='string' name='[Evidence_Coverage_Status]' role='dimension' type='nominal' />
            <column caption='Judgment Precondition' datatype='string' name='[Judgment_Precondition]' role='dimension' type='nominal' />
            <column caption='Tableau Status' datatype='string' name='[Tableau_Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0160564932079626]' derivation='Min' name='[min:Calculation_0160564932079626:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0160564888436737]' derivation='None' name='[none:Calculation_0160564888436737:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0160564931989513]' derivation='None' name='[none:Calculation_0160564931989513:nk]' pivot='key' type='nominal' />
